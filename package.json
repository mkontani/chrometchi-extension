{
    "name": "chrometchi-extension",
    "version": "1.0.0",
    "description": "Retro virtual pet Chrome Extension",
    "scripts": {
        "dev": "wxt",
        "build": "wxt build",
        "zip": "wxt zip",
        "postinstall": "wxt prepare",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "e2e": "playwright test",
        "screenshots": "tsx scripts/screenshots.ts",
        "art:check": "tsx scripts/art/check.ts"
    },
    "type": "module",
    "dependencies": {
        "@fontsource/dotgothic16": "^5.3.1",
        "preact": "^10.29.8",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@playwright/test": "^1.64.1",
        "@preact/preset-vite": "^2.10.6",
        "@testing-library/preact": "^3.2.6",
        "@types/node": "^26.6.6",
        "@types/pngjs": "^6.0.5",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "happy-dom": "^21.0.4",
        "pngjs": "^7.0.0",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.1.0",
        "wxt": "^0.21.5"
    }
}
